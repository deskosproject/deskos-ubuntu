# The pinned tool is fetched, not committed: `make fetch` verifies it against
# deskos.sha256, and a binary in the history would be a binary nobody verifies.
.deskos/
dist/
output/

# The deskos-core checkout the workflows make, to read the supply-chain scripts it owns. It is
# a checkout, not a submodule, and nothing of it belongs in this repository's history.
.deskos-core/

# Python bytecode from the vendored harness.
__pycache__/
*.pyc

# Disks written by an install, which are test input and never artifacts.
*.qcow2
*.raw
*.iso

# The rendered build context. `deskosctl render --output ctx` writes it, and it is
# regenerated on every build: it must never be committed.
ctx/
