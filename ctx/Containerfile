FROM quay.io/deskos/deskos-ubuntu-bootc:26.04@sha256:ab66fd826d940ae0a62442cf649479a5ccab1e34ee58db867e455b24e3f6d038

# Package groups
RUN \
    apt-get update \
    && apt-get -y install \
        'ubuntu-desktop-minimal' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Packages
RUN \
    apt-get update \
    && apt-get -y install \
        'curl' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Binary artifact deskos 0.13.0 (sha256-verified)
RUN set -eu; \
    tmp="$(mktemp -d)"; \
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
        --retry 3 --retry-delay 2 --retry-connrefused --retry-max-time 90 \
        --connect-timeout 30 --speed-limit 1000 --speed-time 60 \
        -o "$tmp/download" 'https://github.com/deskosproject/deskos-core/releases/download/v0.13.0/deskos-v0.13.0-linux-amd64'; \
    echo '6c050947c06aed9972d001f0307001d4b30f5e550998da715becf863063cda40  '"$tmp/download" | sha256sum --check --strict --quiet -; \
    mkdir -p "$(readlink -m "$(dirname '/usr/local/bin/deskos')")"; \
    install -D -m 0755 "$tmp/download" '/usr/local/bin/deskos'; \
    rm -rf "$tmp"

# Image files
COPY rootfs/ /

# System configuration
RUN systemctl enable 'deskos-image-update.timer' 'gdm.service' \
    && systemctl mask 'bootc-fetch-apply-updates.service' 'bootc-fetch-apply-updates.timer' \
    && systemctl set-default 'graphical.target'

# Cleanup and bootc validation
RUN rm -rf /var/cache/apt /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && bootc container lint

